{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fideflow.local/schemas/provider-service.v1.schema.json",
  "title": "Fideflow remote provider capability envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocolVersion", "capabilities"],
  "properties": {
    "protocolVersion": {"const": 1},
    "capabilities": {
      "type": "object",
      "additionalProperties": {"type": "boolean"},
      "required": ["catalog", "sourceResolution"]
    }
  }
}
