{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ncm-host.v1.schema.json",
  "title": "NCM Host request and completion",
  "$defs": {
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requestId",
        "accountEpoch",
        "route",
        "params",
        "cookie",
        "deviceId",
        "budgetMs",
        "maxResponseBytes"
      ],
      "properties": {
        "requestId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "accountEpoch": {
          "type": "integer",
          "minimum": 0
        },
        "route": {
          "type": "string"
        },
        "params": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "cookie": {
          "type": [
            "string",
            "null"
          ]
        },
        "deviceId": {
          "type": "string",
          "pattern": "^[0-9A-F]{52}$"
        },
        "budgetMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 15000
        },
        "maxResponseBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16777216
        }
      }
    },
    "completion": {
      "type": "object",
      "required": [
        "schemaVersion",
        "requestId",
        "accountEpoch"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "requestId": {
          "type": "string"
        },
        "accountEpoch": {
          "type": "integer",
          "minimum": 0
        },
        "status": {
          "type": "integer"
        },
        "body": {},
        "setCookie": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "serverTime": {
          "type": [
            "string",
            "null"
          ]
        },
        "error": {
          "enum": [
            "network.timeout",
            "network.unreachable",
            "ncm.responseTooLarge",
            "provider.schemaChanged",
            "ncm.upstreamError"
          ]
        }
      },
      "oneOf": [
        {
          "required": [
            "status",
            "body",
            "setCookie"
          ],
          "not": {
            "required": [
              "error"
            ]
          }
        },
        {
          "required": [
            "error"
          ],
          "not": {
            "required": [
              "status"
            ]
          }
        }
      ]
    }
  }
}
